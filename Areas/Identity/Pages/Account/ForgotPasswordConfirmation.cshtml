@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Email Inviata";
}

<div class="confirmation-wrapper">
    <div class="confirmation-container">
        <div class="confirmation-header">
            <div class="confirmation-icon">
                <div class="success-checkmark">
                    <div class="check-icon">
                        <span class="icon-line line-tip"></span>
                        <span class="icon-line line-long"></span>
                        <div class="icon-circle"></div>
                       
                    </div>
                </div>
            </div>
            <h1 class="confirmation-title">Email Inviata con Successo!</h1>
            <p class="confirmation-subtitle">Controlla la tua casella di posta</p>
        </div>

        <div class="confirmation-content">
            <div class="message-box">
                <div class="message-icon">📬</div>
                <div class="message-text">
                    <p><strong>Abbiamo inviato un'email al tuo indirizzo.</strong></p>
                    <p>Segui le istruzioni contenute nell'email per reimpostare la tua password.</p>
                </div>
            </div>

            <div class="steps-box">
                <h3 class="steps-title">Prossimi Passi:</h3>
                <div class="step-item">
                    <div class="step-number">1</div>
                    <div class="step-content">
                        <strong>Controlla la tua email</strong>
                        <p>Cerca un'email da noi nella tua casella di posta</p>
                    </div>
                </div>
                <div class="step-item">
                    <div class="step-number">2</div>
                    <div class="step-content">
                        <strong>Clicca sul link</strong>
                        <p>Il link è valido per 24 ore</p>
                    </div>
                </div>
                <div class="step-item">
                    <div class="step-number">3</div>
                    <div class="step-content">
                        <strong>Crea una nuova password</strong>
                        <p>Scegli una password sicura e memorabile</p>
                    </div>
                </div>
            </div>

            <div class="info-box-confirm">
                <div class="info-icon-confirm">💡</div>
                <div class="info-content-confirm">
                    <strong>Non hai ricevuto l'email?</strong>
                    <ul>
                        <li>Controlla la cartella spam o posta indesiderata</li>
                        <li>Verifica di aver inserito l'indirizzo email corretto</li>
                        <li>Attendi qualche minuto, l'email potrebbe essere in arrivo</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="confirmation-footer">
            <a asp-page="./Login" class="btn-premium-back">
                <span class="btn-icon">←</span>
                <span class="btn-text">Torna al Login</span>
            </a>
            <p class="help-text">
                Problemi? <a asp-page="./ForgotPassword" class="link-premium">Invia nuovamente l'email</a>
            </p>
        </div>
    </div>
</div>

