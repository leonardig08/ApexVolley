@page
@model LoginModel

<div class="login-wrapper">
    <div class="login-container-premium">
        <div class="login-header">
            <div class="login-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                    <polyline points="10 17 15 12 10 7"></polyline>
                    <line x1="15" y1="12" x2="3" y2="12"></line>
                </svg>
            </div>
            <h1 class="login-title">Bentornato!</h1>
            <p class="login-subtitle">Accedi al tuo account</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="alert-premium alert-danger-premium mb-4" role="alert"></div>

        <form id="account" method="post" novalidate class="login-form-premium">
            <div class="form-group-premium mb-4">
                <label asp-for="Input.Login" class="form-label-premium">
                    <span class="label-icon">👤</span>
                    Email o Username
                </label>
                <div class="input-wrapper">
                    <input asp-for="Input.Login" class="form-control-premium" autocomplete="username" placeholder="Inserisci email o username" aria-required="true" />
                    <span class="input-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </span>
                </div>
                <span asp-validation-for="Input.Login" class="validation-message"></span>
            </div>

            <div class="form-group-premium mb-4">
                <label asp-for="Input.Password" class="form-label-premium">
                    <span class="label-icon">🔒</span>
                    Password
                </label>
                <div class="input-wrapper">
                    <input asp-for="Input.Password" type="password" class="form-control-premium" autocomplete="current-password" placeholder="Inserisci la password" aria-required="true" />
                    <span class="input-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                    </span>
                </div>
                <span asp-validation-for="Input.Password" class="validation-message"></span>
            </div>

            <div class="login-options">
                <div class="remember-me">
                    <input class="form-check-input-premium" asp-for="Input.RememberMe" type="checkbox" id="rememberMeCheck" />
                    <label class="form-check-label-premium" for="rememberMeCheck">
                        Ricordami
                    </label>
                </div>
                <a id="forgot-password" asp-page="./ForgotPassword" class="link-premium-small">
                    Password dimenticata?
                </a>
            </div>

            <button id="login-submit" type="submit" class="btn-premium-login">
                <span class="btn-text">Accedi</span>
                <span class="btn-icon">→</span>
            </button>
        </form>

        <div class="login-footer">
            <div class="divider">
                <span>oppure</span>
            </div>
            <p class="register-link">
                Non hai un account?
                <a asp-controller="Register" asp-action="Index" asp-route-returnUrl="@Model.ReturnUrl" class="link-premium">
                    Registrati ora
                </a>
            </p>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}