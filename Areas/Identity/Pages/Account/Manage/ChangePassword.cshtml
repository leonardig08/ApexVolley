@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Cambia Password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="profile-wrapper d-flex justify-content-center align-self-center">
    <div class="profile-container">
        <div class="profile-header">
            <div class="profile-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
            </div>
            <h1 class="profile-title">Cambia Password</h1>
            <p class="profile-subtitle">Aggiorna la tua password per mantenere il tuo account sicuro</p>
        </div>

        <partial name="_StatusMessage" for="StatusMessage" />

        <div class="profile-content">
            <form id="change-password-form" method="post" class="profile-form">
                <div asp-validation-summary="ModelOnly" class="alert-premium alert-danger-premium mb-4" role="alert"></div>

                <div class="form-section-profile">
                    <h3 class="section-title-profile">
                        <span class="section-icon">🔐</span>
                        Credenziali di Sicurezza
                    </h3>

                    <div class="form-group-premium mb-4">
                        <label asp-for="Input.OldPassword" class="form-label-premium">
                            <span class="label-icon">🔑</span>
                            Password Attuale
                        </label>
                        <div class="input-wrapper">
                            <input asp-for="Input.OldPassword" class="form-control-premium" type="password" autocomplete="current-password" aria-required="true" placeholder="Inserisci la password attuale" />
                            <span class="input-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                            </span>
                        </div>
                        <span asp-validation-for="Input.OldPassword" class="validation-message"></span>
                        <small class="input-help">Per sicurezza, conferma la tua password attuale</small>
                    </div>

                    <div class="form-group-premium mb-4">
                        <label asp-for="Input.NewPassword" class="form-label-premium">
                            <span class="label-icon">🆕</span>
                            Nuova Password
                        </label>
                        <div class="input-wrapper">
                            <input asp-for="Input.NewPassword" class="form-control-premium" type="password" autocomplete="new-password" aria-required="true" placeholder="Inserisci la nuova password" />
                            <span class="input-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                </svg>
                            </span>
                        </div>
                        <span asp-validation-for="Input.NewPassword" class="validation-message"></span>
                        <small class="input-help">Minimo 6 caratteri, usa lettere maiuscole, minuscole e numeri</small>
                    </div>

                    <div class="form-group-premium mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label-premium">
                            <span class="label-icon">✅</span>
                            Conferma Nuova Password
                        </label>
                        <div class="input-wrapper">
                            <input asp-for="Input.ConfirmPassword" class="form-control-premium" type="password" autocomplete="new-password" aria-required="true" placeholder="Conferma la nuova password" />
                            <span class="input-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                                </svg>
                            </span>
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="validation-message"></span>
                        <small class="input-help">Reinserisci la nuova password per conferma</small>
                    </div>
                </div>

                <div class="info-box-profile">
                    <div class="info-icon-profile">🛡️</div>
                    <div class="info-content-profile">
                        <strong>Consigli per una Password Sicura</strong>
                        <p>Usa almeno 8 caratteri con una combinazione di lettere maiuscole, minuscole, numeri e simboli. Evita informazioni personali facilmente identificabili.</p>
                    </div>
                </div>

                <div class="form-actions-profile">
                    <button type="submit" class="btn-premium-save">
                        <span class="btn-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                                <polyline points="17 21 17 13 7 13 7 21"></polyline>
                                <polyline points="7 3 7 8 15 8"></polyline>
                            </svg>
                        </span>
                        <span class="btn-text">Aggiorna Password</span>
                    </button>
                </div>
            </form>

            <div class="additional-actions">
                <h3 class="actions-title">Altre Opzioni di Sicurezza</h3>
                <div class="action-cards">
                    <a asp-page="./Index" class="action-card">
                        <div class="action-icon email-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </div>
                        <div class="action-content">
                            <h4>Torna al Profilo</h4>
                            <p>Visualizza e modifica le informazioni del tuo account</p>
                        </div>
                        <div class="action-arrow">→</div>
                    </a>

                    <a asp-page="./Email" class="action-card">
                        <div class="action-icon password-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                <polyline points="22,6 12,13 2,6"></polyline>
                            </svg>
                        </div>
                        <div class="action-content">
                            <h4>Modifica Email</h4>
                            <p>Cambia l'indirizzo email associato al tuo account</p>
                        </div>
                        <div class="action-arrow">→</div>
                    </a>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<footer class="border-top footer text-muted">
    <div class="container text-center">
        <p>
            &copy; 2025 - ApexVolley -
            <a href="/" class="text-apex-gold">Home</a> |
            <a href="mailto:info@apexvolley.it" class="text-apex-gold">Contatti</a> |
            <a asp-controller="Home" asp-action="Privacy" class="text-apex-gold">Privacy</a>
        </p>
    </div>
</footer>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}