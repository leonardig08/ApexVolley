@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Elimina Dati Personali";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<style>
    /* Danger Theme Styles */
    .danger-icon {
        background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
    }

    .danger-title {
        color: #c92a2a;
    }

    /* Alert Danger Custom */
    .alert-danger-custom {
        background: linear-gradient(135deg, #ffe0e0 0%, #ffd4d4 100%);
        border-left: 5px solid #f03e3e;
        border-radius: 12px;
        padding: 1.5rem;
        display: flex;
        gap: 1.25rem;
        box-shadow: 0 4px 12px rgba(240, 62, 62, 0.15);
    }

    .alert-danger-icon {
        flex-shrink: 0;
        color: #c92a2a;
        display: flex;
        align-items: center;
    }

    .alert-danger-content h4 {
        color: #c92a2a;
        font-size: 1.1rem;
        font-weight: 700;
        margin: 0 0 0.75rem 0;
    }

    .alert-danger-content p {
        color: #862e2e;
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 0.75rem;
    }

        .alert-danger-content p:last-child {
            margin-bottom: 0;
        }

    /* Deletion Consequences Section */
    .deletion-consequences {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    .consequences-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .consequences-list {
        display: grid;
        gap: 1rem;
    }

    .consequence-item {
        display: flex;
        gap: 1rem;
        padding: 1rem;
        background: #f8f9fa;
        border-radius: 8px;
        border-left: 3px solid #dee2e6;
        transition: all 0.3s ease;
    }

        .consequence-item:hover {
            background: #fff5f5;
            border-left-color: #f03e3e;
        }

    .consequence-icon {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #ff8787 0%, #ff6b6b 100%);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        flex-shrink: 0;
    }

    .consequence-text strong {
        display: block;
        color: #1a1a1a;
        font-size: 0.95rem;
        margin-bottom: 0.25rem;
    }

    .consequence-text p {
        margin: 0;
        color: #666;
        font-size: 0.85rem;
        line-height: 1.4;
    }

    /* Final Warning Box */
    .final-warning-box {
        background: linear-gradient(135deg, #fff3cd 0%, #ffe69c 100%);
        border: 2px solid #ffc107;
        border-radius: 12px;
        padding: 1.5rem;
        display: flex;
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .final-warning-icon {
        font-size: 2rem;
        flex-shrink: 0;
    }

    .final-warning-content h5 {
        color: #856404;
        font-size: 1rem;
        font-weight: 700;
        margin: 0 0 0.5rem 0;
    }

    .final-warning-content p {
        margin: 0;
        color: #856404;
        font-size: 0.9rem;
        line-height: 1.6;
    }

    /* Danger Delete Button */
    .btn-danger-delete {
        width: 100%;
        padding: 1.25rem 2rem;
        background: linear-gradient(135deg, #f03e3e 0%, #c92a2a 100%);
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 1.1rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(240, 62, 62, 0.3);
    }

        .btn-danger-delete:hover {
            background: linear-gradient(135deg, #c92a2a 0%, #a61e1e 100%);
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(240, 62, 62, 0.4);
        }

        .btn-danger-delete:active {
            transform: translateY(0);
        }

        .btn-danger-delete .btn-icon {
            display: flex;
            align-items: center;
        }

    .form-actions-danger {
        margin-top: 2rem;
    }

    /* Safe Action Cards */
    .safe-action {
        border-color: #d4edda !important;
    }

        .safe-action:hover {
            border-color: #28a745 !important;
            box-shadow: 0 4px 12px rgba(40, 167, 69, 0.15) !important;
        }

        .safe-action .action-icon {
            background: linear-gradient(135deg, #28a745 0%, #218838 100%) !important;
        }
</style>

<div class="profile-wrapper d-flex justify-content-center align-self-center">
    <div class="profile-container">
        <div class="profile-header">
            <div class="profile-icon danger-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
            </div>
            <h1 class="profile-title danger-title">Elimina Dati Personali</h1>
            <p class="profile-subtitle">Questa azione è permanente e irreversibile</p>
        </div>

        <div class="profile-content">
            <div class="alert-danger-custom mb-4">
                <div class="alert-danger-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                </div>
                <div class="alert-danger-content">
                    <h4>⚠️ Attenzione: Azione Irreversibile</h4>
                    <p><strong>L'eliminazione di questi dati rimuoverà permanentemente il tuo account e questo non può essere recuperato.</strong></p>
                    <p class="mb-0">Tutti i tuoi ordini, preferenze e informazioni personali saranno cancellati definitivamente dai nostri sistemi.</p>
                </div>
            </div>

            <div class="deletion-consequences mb-4">
                <h3 class="consequences-title">
                    <span class="section-icon">📋</span>
                    Cosa Verrà Eliminato
                </h3>
                <div class="consequences-list">
                    <div class="consequence-item">
                        <div class="consequence-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </div>
                        <div class="consequence-text">
                            <strong>Profilo Utente</strong>
                            <p>Nome, email, numero di telefono e tutte le informazioni personali</p>
                        </div>
                    </div>
                    <div class="consequence-item">
                        <div class="consequence-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                        </div>
                        <div class="consequence-text">
                            <strong>Storico Ordini</strong>
                            <p>Tutti gli ordini effettuati e le transazioni associate</p>
                        </div>
                    </div>
                    <div class="consequence-item">
                        <div class="consequence-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 20h9"></path>
                                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                            </svg>
                        </div>
                        <div class="consequence-text">
                            <strong>Preferenze e Impostazioni</strong>
                            <p>Tutte le tue configurazioni personalizzate</p>
                        </div>
                    </div>
                    <div class="consequence-item">
                        <div class="consequence-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                        </div>
                        <div class="consequence-text">
                            <strong>Accesso all'Account</strong>
                            <p>Non potrai più accedere con queste credenziali</p>
                        </div>
                    </div>
                </div>
            </div>

            <form id="delete-user" method="post" class="profile-form">
                <div asp-validation-summary="ModelOnly" class="alert-premium alert-danger-premium mb-4" role="alert"></div>

                <div class="form-section-profile">
                    <h3 class="section-title-profile">
                        <span class="section-icon">🔐</span>
                        Conferma Identità
                    </h3>

                    @if (Model.RequirePassword)
                    {
                        <div class="form-group-premium mb-4">
                            <label asp-for="Input.Password" class="form-label-premium">
                                <span class="label-icon">🔑</span>
                                Password
                            </label>
                            <div class="input-wrapper">
                                <input asp-for="Input.Password" class="form-control-premium" type="password" autocomplete="current-password" aria-required="true" placeholder="Inserisci la tua password per confermare" />
                                <span class="input-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                    </svg>
                                </span>
                            </div>
                            <span asp-validation-for="Input.Password" class="validation-message"></span>
                            <small class="input-help">Inserisci la tua password per confermare l'eliminazione dell'account</small>
                        </div>
                    }

                    <div class="final-warning-box">
                        <div class="final-warning-icon">🛑</div>
                        <div class="final-warning-content">
                            <h5>Ultima Conferma</h5>
                            <p>Cliccando sul pulsante qui sotto, il tuo account verrà eliminato immediatamente e permanentemente. Assicurati di aver scaricato tutti i dati di cui potresti aver bisogno.</p>
                        </div>
                    </div>
                </div>

                <div class="form-actions-profile form-actions-danger">
                    <button class="btn-danger-delete" type="submit">
                        <span class="btn-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                <line x1="10" y1="11" x2="10" y2="17"></line>
                                <line x1="14" y1="11" x2="14" y2="17"></line>
                            </svg>
                        </span>
                        <span class="btn-text">Elimina Dati e Chiudi Account</span>
                    </button>
                </div>
            </form>

            <div class="additional-actions">
                <h3 class="actions-title">Hai Cambiato Idea?</h3>
                <div class="action-cards">
                    <a asp-page="./PersonalData" class="action-card safe-action">
                        <div class="action-icon email-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="19" y1="12" x2="5" y2="12"></line>
                                <polyline points="12 19 5 12 12 5"></polyline>
                            </svg>
                        </div>
                        <div class="action-content">
                            <h4>Torna Indietro</h4>
                            <p>Ritorna alla pagina dei dati personali senza eliminare nulla</p>
                        </div>
                        <div class="action-arrow">→</div>
                    </a>

                    <a asp-page="PersonalData" class="action-card safe-action">
                        <div class="action-icon password-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="7 10 12 15 17 10"></polyline>
                                <line x1="12" y1="15" x2="12" y2="3"></line>
                            </svg>
                        </div>
                        <div class="action-content">
                            <h4>Scarica Prima i Dati</h4>
                            <p>Salva una copia dei tuoi dati prima di eliminarli</p>
                        </div>
                        <div class="action-arrow">→</div>
                    </a>

                    <a href="mailto:info@apexvolley.it" class="action-card safe-action">
                        <div class="action-icon data-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                            </svg>
                        </div>
                        <div class="action-content">
                            <h4>Contatta il Supporto</h4>
                            <p>Hai domande? Parla con il nostro team prima di decidere</p>
                        </div>
                        <div class="action-arrow">→</div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<footer class="border-top footer text-muted">
    <div class="container text-center">
        <p>
            &copy; 2025 - ApexVolley -
            <a href="/" class="text-apex-gold">Home</a> |
            <a href="mailto:info@apexvolley.it" class="text-apex-gold">Contatti</a> |
            <a asp-controller="Home" asp-action="Privacy" class="text-apex-gold">Privacy</a>
        </p>
    </div>
</footer>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}