@page
@model EmailModel
@{
    ViewData["Title"] = "Gestisci Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="profile-wrapper d-flex justify-content-center align-self-center">
    <div class="profile-container">
        <div class="profile-header">
            <div class="profile-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
            </div>
            <h1 class="profile-title">Gestisci Email</h1>
            <p class="profile-subtitle">Modifica l'indirizzo email del tuo account</p>
        </div>

        <partial name="_StatusMessage" for="StatusMessage" />

        <div class="profile-content">
            <form id="email-form" method="post" class="profile-form">

                <div class="form-section-profile">
                    <h3 class="section-title-profile">
                        <span class="section-icon">📧</span>
                        Email Attuale
                    </h3>

                    @if (Model.IsEmailConfirmed)
                    {
                        <div class="form-group-premium mb-4">
                            <label asp-for="Email" class="form-label-premium">
                                <span class="label-icon">✉️</span>
                                Indirizzo Email
                            </label>
                            <div class="input-wrapper">
                                <input asp-for="Email" class="form-control-premium disabled-input" placeholder="La tua email" disabled />
                                <span class="input-icon verified-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                                    </svg>
                                </span>
                            </div>
                            <small class="input-help verified-help">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                                </svg>
                                Email verificata
                            </small>
                        </div>
                    }
                    else
                    {
                        <div class="form-group-premium mb-4">
                            <label asp-for="Email" class="form-label-premium">
                                <span class="label-icon">✉️</span>
                                Indirizzo Email
                            </label>
                            <div class="input-wrapper">
                                <input asp-for="Email" class="form-control-premium disabled-input" placeholder="La tua email" disabled />
                                <span class="input-icon warning-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                        <line x1="12" y1="9" x2="12" y2="13"></line>
                                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                    </svg>
                                </span>
                            </div>
                            <small class="input-help warning-help">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                    <line x1="12" y1="9" x2="12" y2="13"></line>
                                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                </svg>
                                Email non verificata
                            </small>
                            <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn-verify-email mt-2">
                                <span class="btn-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="22,6 12,13 2,6"></polyline>
                                        <path d="M22 6v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2h16c1.1 0 2 .9 2 2z"></path>
                                    </svg>
                                </span>
                                <span class="btn-text">Invia email di verifica</span>
                            </button>
                        </div>
                    }
                </div>

                <div class="form-section-profile mt-4">
                    <h3 class="section-title-profile">
                        <span class="section-icon">🔄</span>
                        Nuova Email
                    </h3>

                    <div class="form-group-premium mb-4">
                        <label asp-for="Input.NewEmail" class="form-label-premium">
                            <span class="label-icon">📮</span>
                            Nuovo Indirizzo Email
                        </label>
                        <div class="input-wrapper">
                            <input asp-for="Input.NewEmail" class="form-control-premium" autocomplete="email" aria-required="true" placeholder="Inserisci la nuova email" />
                            <span class="input-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                    <polyline points="22,6 12,13 2,6"></polyline>
                                </svg>
                            </span>
                        </div>
                        <span asp-validation-for="Input.NewEmail" class="validation-message"></span>
                        <small class="input-help">Inserisci un indirizzo email valido</small>
                    </div>
                </div>

                <div class="info-box-profile">
                    <div class="info-icon-profile">⚠️</div>
                    <div class="info-content-profile">
                        <strong>Importante</strong>
                        <p>Dopo aver modificato l'email, riceverai un messaggio di conferma al nuovo indirizzo. Dovrai verificare la nuova email per completare il processo.</p>
                    </div>
                </div>

                <div class="form-actions-profile">
                    <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn-premium-save">
                        <span class="btn-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                                <polyline points="17 21 17 13 7 13 7 21"></polyline>
                                <polyline points="7 3 7 8 15 8"></polyline>
                            </svg>
                        </span>
                        <span class="btn-text">Cambia Email</span>
                    </button>
                </div>
            </form>

            <div class="additional-actions">
                <h3 class="actions-title">Altre Opzioni</h3>
                <div class="action-cards">
                    <a asp-page="./Index" class="action-card">
                        <div class="action-icon email-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </div>
                        <div class="action-content">
                            <h4>Torna al Profilo</h4>
                            <p>Visualizza e modifica le informazioni del tuo account</p>
                        </div>
                        <div class="action-arrow">→</div>
                    </a>

                    <a asp-page="./ChangePassword" class="action-card">
                        <div class="action-icon password-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                        </div>
                        <div class="action-content">
                            <h4>Cambia Password</h4>
                            <p>Aggiorna la tua password per maggiore sicurezza</p>
                        </div>
                        <div class="action-arrow">→</div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<footer class="border-top footer text-muted">
    <div class="container text-center">
        <p>
            &copy; 2025 - ApexVolley -
            <a href="/" class="text-apex-gold">Home</a> |
            <a href="mailto:info@apexvolley.it" class="text-apex-gold">Contatti</a> |
            <a asp-controller="Home" asp-action="Privacy" class="text-apex-gold">Privacy</a>
        </p>
    </div>
</footer>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}