@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Dati Personali";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<style>
    /* Data Action Section */
    .data-action-section {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        margin-bottom: 2rem;
    }

    /* Data Action Cards */
    .data-action-card {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        border: 2px solid #f0f0f0;
        transition: all 0.3s ease;
    }

        .data-action-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
        }

    .download-card {
        border-color: #e3f2fd;
    }

        .download-card:hover {
            border-color: #2196f3;
            box-shadow: 0 8px 16px rgba(33, 150, 243, 0.15);
        }

    .delete-card {
        border-color: #ffebee;
    }

        .delete-card:hover {
            border-color: #ef5350;
            box-shadow: 0 8px 16px rgba(239, 83, 80, 0.15);
        }

    /* Data Action Header */
    .data-action-header {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 2px solid #f5f5f5;
    }

    .data-action-icon {
        width: 64px;
        height: 64px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .download-icon {
        background: linear-gradient(135deg, #2196f3 0%, #1976d2 100%);
        color: white;
    }

    .delete-icon {
        background: linear-gradient(135deg, #ef5350 0%, #d32f2f 100%);
        color: white;
    }

    .data-action-title h4 {
        font-size: 1.25rem;
        font-weight: 700;
        color: #1a1a1a;
        margin: 0 0 0.5rem 0;
    }

    .data-action-title p {
        font-size: 0.9rem;
        color: #666;
        margin: 0;
        line-height: 1.5;
    }

    /* Data Features List */
    .data-features-list {
        list-style: none;
        padding: 0;
        margin: 0 0 1.5rem 0;
    }

        .data-features-list li {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 0;
            font-size: 0.95rem;
            color: #444;
        }

            .data-features-list li svg {
                color: #4caf50;
                flex-shrink: 0;
            }

    /* Warning Box Data */
    .warning-box-data {
        background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
        border-left: 4px solid #ff9800;
        border-radius: 8px;
        padding: 1.25rem;
        margin-bottom: 1.5rem;
        display: flex;
        gap: 1rem;
    }

    .warning-icon-data {
        font-size: 1.75rem;
        flex-shrink: 0;
    }

    .warning-content-data strong {
        display: block;
        color: #e65100;
        font-size: 1rem;
        margin-bottom: 0.5rem;
    }

    .warning-content-data p {
        margin: 0;
        font-size: 0.9rem;
        color: #5d4037;
        line-height: 1.6;
    }

    /* Action Buttons */
    .btn-data-download,
    .btn-data-delete {
        width: 100%;
        padding: 1rem 1.5rem;
        border: none;
        border-radius: 12px;
        font-size: 1rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
    }

    .btn-data-download {
        background: linear-gradient(135deg, #2196f3 0%, #1976d2 100%);
        color: white;
        box-shadow: 0 4px 12px rgba(33, 150, 243, 0.3);
    }

        .btn-data-download:hover {
            background: linear-gradient(135deg, #1976d2 0%, #1565c0 100%);
            box-shadow: 0 6px 16px rgba(33, 150, 243, 0.4);
            transform: translateY(-2px);
            color: white;
        }

    .btn-data-delete {
        background: linear-gradient(135deg, #ef5350 0%, #d32f2f 100%);
        color: white;
        box-shadow: 0 4px 12px rgba(239, 83, 80, 0.3);
    }

        .btn-data-delete:hover {
            background: linear-gradient(135deg, #d32f2f 0%, #c62828 100%);
            box-shadow: 0 6px 16px rgba(239, 83, 80, 0.4);
            transform: translateY(-2px);
            color: white;
        }

        .btn-data-download .btn-icon,
        .btn-data-delete .btn-icon {
            display: flex;
            align-items: center;
        }
</style>

<div class="profile-wrapper d-flex justify-content-center align-self-center">
    <div class="profile-container">
        <div class="profile-header">
            <div class="profile-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
            </div>
            <h1 class="profile-title">Dati Personali</h1>
            <p class="profile-subtitle">Gestisci, scarica o elimina i tuoi dati personali</p>
        </div>

        <div class="profile-content">
            <div class="form-section-profile">
                <h3 class="section-title-profile">
                    <span class="section-icon">📊</span>
                    I Tuoi Dati
                </h3>

                <div class="info-box-profile mb-4">
                    <div class="info-icon-profile">ℹ️</div>
                    <div class="info-content-profile">
                        <strong>Informazioni sui Dati</strong>
                        <p>Il tuo account contiene dati personali che ci hai fornito. Questa pagina ti permette di scaricare o eliminare questi dati in conformità con le normative sulla privacy.</p>
                    </div>
                </div>

                <div class="data-action-section">
                    <div class="data-action-card download-card">
                        <div class="data-action-header">
                            <div class="data-action-icon download-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                    <polyline points="7 10 12 15 17 10"></polyline>
                                    <line x1="12" y1="15" x2="12" y2="3"></line>
                                </svg>
                            </div>
                            <div class="data-action-title">
                                <h4>Scarica i Tuoi Dati</h4>
                                <p>Ricevi una copia di tutti i tuoi dati personali in formato JSON</p>
                            </div>
                        </div>
                        <div class="data-action-content">
                            <ul class="data-features-list">
                                <li>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                    Informazioni del profilo
                                </li>
                                <li>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                    Storico ordini e transazioni
                                </li>
                                <li>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                    Preferenze e impostazioni
                                </li>
                            </ul>
                            <form id="download-data" asp-page="DownloadPersonalData" method="post">
                                <button class="btn-data-download" type="submit">
                                    <span class="btn-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                            <polyline points="7 10 12 15 17 10"></polyline>
                                            <line x1="12" y1="15" x2="12" y2="3"></line>
                                        </svg>
                                    </span>
                                    <span class="btn-text">Scarica Dati</span>
                                </button>
                            </form>
                        </div>
                    </div>

                    <div class="data-action-card delete-card">
                        <div class="data-action-header">
                            <div class="data-action-icon delete-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                    <line x1="10" y1="11" x2="10" y2="17"></line>
                                    <line x1="14" y1="11" x2="14" y2="17"></line>
                                </svg>
                            </div>
                            <div class="data-action-title">
                                <h4>Elimina il Tuo Account</h4>
                                <p>Rimuovi permanentemente il tuo account e tutti i dati associati</p>
                            </div>
                        </div>
                        <div class="data-action-content">
                            <div class="warning-box-data">
                                <div class="warning-icon-data">⚠️</div>
                                <div class="warning-content-data">
                                    <strong>Attenzione: Azione Irreversibile</strong>
                                    <p>L'eliminazione dei dati rimuoverà <strong>permanentemente</strong> il tuo account e tutte le informazioni associate. Questa operazione <strong>non può essere annullata</strong>.</p>
                                </div>
                            </div>
                            <a id="delete" asp-page="DeletePersonalData" class="btn-data-delete">
                                <span class="btn-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6"></polyline>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                    </svg>
                                </span>
                                <span class="btn-text">Elimina Account</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="additional-actions">
                <h3 class="actions-title">Altre Opzioni</h3>
                <div class="action-cards">
                    <a asp-page="./Index" class="action-card">
                        <div class="action-icon email-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </div>
                        <div class="action-content">
                            <h4>Torna al Profilo</h4>
                            <p>Visualizza e modifica le informazioni del tuo account</p>
                        </div>
                        <div class="action-arrow">→</div>
                    </a>

                    <a asp-page="./Email" class="action-card">
                        <div class="action-icon password-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                <polyline points="22,6 12,13 2,6"></polyline>
                            </svg>
                        </div>
                        <div class="action-content">
                            <h4>Modifica Email</h4>
                            <p>Cambia l'indirizzo email associato al tuo account</p>
                        </div>
                        <div class="action-arrow">→</div>
                    </a>

                    <a asp-controller="Home" asp-action="Privacy" class="action-card">
                        <div class="action-icon data-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                                <line x1="16" y1="13" x2="8" y2="13"></line>
                                <line x1="16" y1="17" x2="8" y2="17"></line>
                                <polyline points="10 9 9 9 8 9"></polyline>
                            </svg>
                        </div>
                        <div class="action-content">
                            <h4>Privacy Policy</h4>
                            <p>Leggi la nostra politica sulla privacy</p>
                        </div>
                        <div class="action-arrow">→</div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<footer class="border-top footer text-muted">
    <div class="container text-center">
        <p>
            &copy; 2025 - ApexVolley -
            <a href="/" class="text-apex-gold">Home</a> |
            <a href="mailto:info@apexvolley.it" class="text-apex-gold">Contatti</a> |
            <a asp-controller="Home" asp-action="Privacy" class="text-apex-gold">Privacy</a>
        </p>
    </div>
</footer>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}