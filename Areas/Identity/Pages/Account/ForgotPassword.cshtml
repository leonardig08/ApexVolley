@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Password Dimenticata";
}

<div class="forgot-password-wrapper">
    <div class="forgot-password-container">
        <div class="forgot-password-header">
            <div class="forgot-password-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
            </div>
            <h1 class="forgot-password-title">Password Dimenticata?</h1>
            <p class="forgot-password-subtitle">Nessun problema! Inserisci la tua email e ti invieremo le istruzioni per reimpostarla.</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="alert-premium alert-danger-premium mb-4" role="alert"></div>

        <div class="info-box">
            <div class="info-icon">💡</div>
            <div class="info-content">
                <strong>Come funziona?</strong>
                <p>Riceverai un'email con un link sicuro per creare una nuova password. Il link sarà valido per 24 ore.</p>
            </div>
        </div>

        <form method="post" class="forgot-password-form">
            <div class="form-group-premium mb-4">
                <label asp-for="Input.Email" class="form-label-premium">
                    <span class="label-icon">📧</span>
                    Indirizzo Email
                </label>
                <div class="input-wrapper">
                    <input asp-for="Input.Email" class="form-control-premium" autocomplete="username" aria-required="true" placeholder="Inserisci la tua email" />
                    <span class="input-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                    </span>
                </div>
                <span asp-validation-for="Input.Email" class="validation-message"></span>
                <small class="input-help">Inserisci l'email associata al tuo account</small>
            </div>

            <button type="submit" class="btn-premium-forgot">
                <span class="btn-text">Invia Link di Reset</span>
                <span class="btn-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                </span>
            </button>
        </form>

        <div class="forgot-password-footer">
            <div class="divider">
                <span>oppure</span>
            </div>
            <p class="back-link">
                Ricordi la password?
                <a asp-page="./Login" class="link-premium">
                    Torna al Login
                </a>
            </p>
            <p class="register-link">
                Non hai un account?
                <a asp-controller="Register" asp-action="Index" class="link-premium">
                    Registrati ora
                </a>
            </p>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}