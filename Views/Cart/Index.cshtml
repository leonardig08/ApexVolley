@model IEnumerable<ApexVolley.Models.CartItem>
    @{
    ViewData["Title"] = "Carrello";
    decimal total = ViewData["Total"] != null ? (decimal)ViewData["Total"] : 0;
    }

    <div class="cart-wrapper">
        <div class="cart-header">
            <div class="cart-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
            </div>
            <h2 class="cart-title">Il Tuo Carrello</h2>
            <p class="cart-subtitle">@Model.Count() @(Model.Count() == 1 ? "prodotto" : "prodotti") nel carrello</p>
        </div>

        @if (!Model.Any())
    {
        <div class="empty-cart">
            <div class="empty-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
            </div>
            <h3 class="empty-title">Il carrello è vuoto</h3>
            <p class="empty-text">Non hai ancora aggiunto nessun prodotto al carrello</p>
            <a asp-controller="Products" asp-action="Index" class="btn-premium-shop">
                <span class="btn-icon">🛍️</span>
                <span class="btn-text">Vai allo Shop</span>
            </a>
        </div>
    }
    else
    {
        <div class="cart-content">
            <div class="cart-items">
                @foreach (var item in Model)
                {
                <div class="cart-item">
                    <div class="item-info">
                        <h4 class="item-name">@item.Product.Name</h4>
                        <p class="item-price">@item.Product.Price.ToString("F2") €</p>
                    </div>

                    <div class="item-actions">
                        <form asp-action="Update" method="post" class="quantity-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <div class="quantity-control">
                                <label class="quantity-label">Quantità:</label>
                                <div class="quantity-input-group">
                                    <input type="number" name="quantity" value="@item.Quantity" min="1" class="quantity-input" />
                                    <button type="submit" class="btn-premium-update">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                        Aggiorna
                                    </button>
                                </div>
                            </div>
                        </form>

                        <div class="item-total">
                            <span class="total-label">Subtotale:</span>
                            <span class="total-value">@((item.Product.Price * item.Quantity).ToString("F2")) €</span>
                        </div>

                        <form asp-action="Remove" method="post" class="remove-form" onsubmit="return confirm('Vuoi rimuovere questo prodotto?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn-premium-remove">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                </svg>
                                Rimuovi
                            </button>
                        </form>
                    </div>
                </div>
                }
            </div>

            <div class="cart-summary">
                <div class="summary-card">
                    <h3 class="summary-title">Riepilogo Ordine</h3>

                    <div class="summary-details">
                        <div class="summary-row">
                            <span>Subtotale:</span>
                            <span>@total.ToString("F2") €</span>
                        </div>
                        <div class="summary-row">
                            <span>Spedizione:</span>
                            <span class="free-shipping">Gratuita</span>
                        </div>
                        <div class="summary-divider"></div>
                        <div class="summary-row summary-total">
                            <span>Totale:</span>
                            <span class="total-amount">@total.ToString("F2") €</span>
                        </div>
                    </div>

                    <a asp-controller="Checkout" asp-action="Index" class="btn-premium-checkout">
                        <span class="btn-text">Procedi al Checkout</span>
                        <span class="btn-icon">→</span>
                    </a>

                    <div class="security-badges">
                        <div class="badge-item">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                            <span>Pagamento Sicuro</span>
                        </div>
                        <div class="badge-item">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                            </svg>
                            <span>Acquisto Protetto</span>
                        </div>
                    </div>
                </div>

                <a asp-controller="Products" asp-action="Index" class="continue-shopping">
                    ← Continua lo Shopping
                </a>
            </div>
        </div>
    }
    </div>
<footer class="border-top footer text-muted">
    <div class="container text-center">
        <p>
            &copy; 2025 - ApexVolley -
            <a href="/" class="text-apex-gold">Home</a> |
            <a href="mailto:info@apexvolley.it" class="text-apex-gold">Contatti</a> |
            <a asp-controller="Home" asp-action="Privacy" class="text-apex-gold">Privacy</a>
        </p>
    </div>
</footer>