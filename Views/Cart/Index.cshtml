@model IEnumerable<ApexVolley.Models.CartItem>
@{
    ViewData["Title"] = "Carrello";
    decimal total = ViewData["Total"] != null ? (decimal)ViewData["Total"] : 0;
}

<h2 class="mb-4">Il tuo carrello</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">Il carrello è vuoto.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Prodotto</th>
                <th>Prezzo</th>
                <th>Quantità</th>
                <th>Totale</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Product.Name</td>
                    <td>@item.Product.Price €</td>
                    <td>
                        <form asp-action="Update" method="post" class="d-flex">
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control form-control-sm me-2" style="width:70px;" />
                            <button type="submit" class="btn btn-sm btn-primary">Aggiorna</button>
                        </form>
                    </td>
                    <td>@(item.Product.Price* item.Quantity) €</td>
                    <td>
                        <form asp-action="Remove" method="post" onsubmit="return confirm('Vuoi rimuovere questo prodotto?');">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-danger">Elimina</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <h4>Totale: @total €</h4>
        <a asp-controller="Checkout" asp-action="Index" class="btn btn-success btn-lg">Procedi al checkout</a>
    </div>
}
