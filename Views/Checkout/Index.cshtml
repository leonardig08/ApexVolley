@model CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
    var cart = Model.CartItems ?? new List<ApexVolley.Models.CartItem>();
    decimal total = cart.Sum(c => c.Product.Price * c.Quantity);
}

<div class="checkout-wrapper">
    <div class="checkout-header">
        <div class="checkout-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
        </div>
        <h2 class="checkout-title">Checkout</h2>
        <p class="checkout-subtitle">Completa il tuo ordine in modo sicuro</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
    <div class="alert-premium alert-danger-premium" role="alert">
        <div class="alert-icon">⚠️</div>
        <div class="alert-content">
            @TempData["ErrorMessage"]
        </div>
    </div>
    }

    @if (!cart.Any())
    {
    <div class="empty-checkout">
        <div class="empty-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
        </div>
        <h3 class="empty-title">Il carrello è vuoto</h3>
        <p class="empty-text">Aggiungi prodotti al carrello prima di procedere al checkout</p>
        <a asp-controller="Product" asp-action="Index" class="btn-premium-shop">
            <span class="btn-icon">🛍️</span>
            <span class="btn-text">Vai allo Shop</span>
        </a>
    </div>
    }
    else
    {
    <div class="checkout-content">
        <!-- Steps Sidebar -->
        <div class="checkout-sidebar">
            <div class="steps-container">
                <div class="step-item active" id="step1-indicator">
                    <div class="step-number">1</div>
                    <div class="step-info">
                        <h4>Dati di Spedizione</h4>
                        <p>Inserisci i tuoi dati</p>
                    </div>
                    <div class="step-check">✓</div>
                </div>
                <div class="step-divider"></div>
                <div class="step-item" id="step2-indicator">
                    <div class="step-number">2</div>
                    <div class="step-info">
                        <h4>Pagamento</h4>
                        <p>Completa l'ordine</p>
                    </div>
                    <div class="step-check">✓</div>
                </div>
            </div>

            <!-- Summary Card -->
            <div class="summary-card-checkout">
                <h3 class="summary-title-checkout">Riepilogo Ordine</h3>
                <div class="summary-items">
                    @foreach (var item in cart)
                        {
                    <div class="summary-item">
                        <img src="@item.Product.ImageUrl" alt="@item.Product.Name" class="summary-item-image" />
                        <div class="summary-item-details">
                            <h5>@item.Product.Name</h5>
                            <p>@item.Quantity x @item.Product.Price.ToString("F2") €</p>
                        </div>
                        <div class="summary-item-total">
                            @((item.Product.Price * item.Quantity).ToString("F2")) €
                        </div>
                    </div>
                        }
                </div>
                <div class="summary-divider"></div>
                <div class="summary-row">
                    <span>Subtotale:</span>
                    <span>@total.ToString("F2") €</span>
                </div>
                <div class="summary-row">
                    <span>Spedizione:</span>
                    <span class="free-shipping">Gratuita</span>
                </div>
                <div class="summary-divider"></div>
                <div class="summary-total-row">
                    <span>Totale:</span>
                    <span class="total-amount">@total.ToString("F2") €</span>
                </div>
            </div>
        </div>

        <!-- Main Form -->
        <div class="checkout-main">
            <form id="checkout-form" asp-controller="Checkout" asp-action="CreateCheckoutSession" method="post" class="checkout-form">
                @Html.AntiForgeryToken()

                <div class="form-section-checkout">
                    <div class="section-header-checkout">
                        <div class="section-icon-checkout">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </div>
                        <h3 class="section-title-checkout">Dati di Spedizione</h3>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="alert-premium alert-danger-premium mb-3"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <div class="form-group-premium">
                                <label asp-for="FullName" class="form-label-premium">
                                    <span class="label-icon">👤</span>
                                    Nome e Cognome
                                </label>
                                <input asp-for="FullName" class="form-control-checkout" placeholder="Mario Rossi" required />
                                <span asp-validation-for="FullName" class="validation-message"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-group-premium">
                                <label asp-for="Address" class="form-label-premium">
                                    <span class="label-icon">📍</span>
                                    Indirizzo
                                </label>
                                <input asp-for="Address" class="form-control-checkout" placeholder="Via Roma, 123" required />
                                <span asp-validation-for="Address" class="validation-message"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group-premium">
                                <label asp-for="City" class="form-label-premium">
                                    <span class="label-icon">🏙️</span>
                                    Città
                                </label>
                                <input asp-for="City" class="form-control-checkout" placeholder="Milano" required />
                                <span asp-validation-for="City" class="validation-message"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group-premium">
                                <label asp-for="ZipCode" class="form-label-premium">
                                    <span class="label-icon">📮</span>
                                    CAP
                                </label>
                                <input asp-for="ZipCode" class="form-control-checkout" placeholder="20100" required />
                                <span asp-validation-for="ZipCode" class="validation-message"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group-premium">
                                <label asp-for="Country" class="form-label-premium">
                                    <span class="label-icon">🌍</span>
                                    Paese
                                </label>
                                <input asp-for="Country" class="form-control-checkout" placeholder="Italia" required />
                                <span asp-validation-for="Country" class="validation-message"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group-premium">
                                <label asp-for="PhoneNumber" class="form-label-premium">
                                    <span class="label-icon">📱</span>
                                    Telefono
                                </label>
                                <input asp-for="PhoneNumber" class="form-control-checkout" placeholder="+39 123 456 7890" required />
                                <span asp-validation-for="PhoneNumber" class="validation-message"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="payment-info">
                    <div class="payment-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                            <line x1="1" y1="10" x2="23" y2="10"></line>
                        </svg>
                    </div>
                    <div class="payment-text">
                        <h4>Pagamento Sicuro con Stripe</h4>
                        <p>Sarai reindirizzato a Stripe per completare il pagamento in modo sicuro</p>
                    </div>
                    <div class="stripe-logo">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/b/ba/Stripe_Logo%2C_revised_2016.svg" alt="Stripe" style="height: 30px;" />
                    </div>
                </div>

                <button type="submit" class="btn-premium-checkout-submit">
                    <span class="btn-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                    </span>
                    <span class="btn-text">Procedi al Pagamento</span>
                    <span class="btn-arrow">→</span>
                </button>

                <div class="security-info">
                    <div class="security-badge">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        </svg>
                        Connessione sicura SSL
                    </div>
                    <div class="security-badge">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        Dati protetti
                    </div>
                </div>
            </form>
        </div>
    </div>
    }
</div>

<footer class="border-top footer text-muted">
    <div class="container text-center">
        <p>
            &copy; 2025 - ApexVolley -
            <a href="/" class="text-apex-gold">Home</a> |
            <a href="mailto:info@apexvolley.it" class="text-apex-gold">Contatti</a> |
            <a asp-controller="Home" asp-action="Privacy" class="text-apex-gold">Privacy</a>
        </p>
    </div>
</footer>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}