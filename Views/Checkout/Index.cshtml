@model CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
    var cart = Model.CartItems ?? new List<ApexVolley.Models.CartItem>();
    decimal total = cart.Sum(c => c.Product.Price * c.Quantity);
}

<h2>Checkout</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}


@if (!cart.Any())
{
    <div class="alert alert-info">Il carrello è vuoto.</div>
}
else
{
    <div class="row">
        <div class="col-md-2">
            <ul class="list-group sticky-top">
                <li class="list-group-item active" id="step1-indicator">1. Dati di spedizione</li>
                <li class="list-group-item disabled" id="step2-indicator">2. Pagamento</li>
            </ul>
        </div>

        <div class="col-md-10">
            <form id="checkout-form" asp-controller="Checkout" asp-action="CreateCheckoutSession" method="post">
                @Html.AntiForgeryToken()
                <h4>Riepilogo carrello</h4>
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Prodotto</th>
                            <th>Prezzo</th>
                            <th>Qtà</th>
                            <th>Totale</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in cart)
                        {
                            <tr>
                                <td>
                                    <img src="@item.Product.ImageUrl" width="50" class="me-2" />
                                    @item.Product.Name
                                </td>
                                <td>@item.Product.Price €</td>
                                <td>@item.Quantity</td>
                                <td>@(item.Product.Price* item.Quantity) €</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <h5>Totale: <strong>@total €</strong></h5>

                <h4 class="mt-4">Dati di spedizione</h4>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">Nome e Cognome</label>
                    <input asp-for="FullName" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label asp-for="Address" class="form-label">Indirizzo</label>
                    <input asp-for="Address" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label asp-for="City" class="form-label">Città</label>
                    <input asp-for="City" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label asp-for="ZipCode" class="form-label">CAP</label>
                    <input asp-for="ZipCode" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label asp-for="Country" class="form-label">Paese</label>
                    <input asp-for="Country" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label">Telefono</label>
                    <input asp-for="PhoneNumber" class="form-control" required />
                </div>

                <button type="submit" class="btn btn-primary btn-lg mt-3">Procedi al pagamento con Stripe</button>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
