@model IEnumerable<ApexVolley.Models.CartItem>
@{
    ViewData["Title"] = "Checkout";
    decimal total = ViewData["Total"] != null ? (decimal)ViewData["Total"] : 0;
}

<h2>Checkout</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">Il carrello è vuoto.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Prodotto</th>
                <th>Prezzo</th>
                <th>Quantità</th>
                <th>Totale</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Product.Name</td>
                    <td>@item.Product.Price €</td>
                    <td>@item.Quantity</td>
                    <td>@(item.Product.Price* item.Quantity) €</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <h4>Totale: @total €</h4>
        <form asp-action="PlaceOrder" method="post">
            <button type="submit" class="btn btn-success btn-lg">Conferma Ordine</button>
        </form>
    </div>
}
