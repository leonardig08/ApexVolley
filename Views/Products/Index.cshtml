@model IEnumerable<ApexVolley.Models.Product>
@{
    ViewData["Title"] = "Shop - Apex Volley";
    var canManage = User.IsInRole("Staff") || User.IsInRole("Admin");
}

<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        /* Apex Volley Color Palette */
        :root {
            --gray-light: #BFBDC1;
            --gray-medium: #6D6A75;
            --gray-dark: #37323E;
            --gold-primary: #DEB841;
            --gold-secondary: #DE9E36;
        }

        body {
            background: linear-gradient(135deg, var(--gray-dark) 0%, var(--gray-medium) 50%, var(--gray-light) 100%);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            min-height: 100vh;
            color: var(--gray-light);
        }

        .shop-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
        }

        /* Header */
        .shop-header {
            background: linear-gradient(135deg, rgba(55, 50, 62, 0.95), rgba(109, 106, 117, 0.9));
            backdrop-filter: blur(20px);
            border: 1px solid rgba(222, 184, 65, 0.3);
            border-radius: 20px;
            padding: 3rem 2rem;
            text-align: center;
            margin-bottom: 3rem;
            box-shadow: 0 20px 40px rgba(55, 50, 62, 0.5);
        }

            .shop-header h1 {
                color: var(--gold-primary);
                font-size: 3.5rem;
                font-weight: 800;
                margin: 0 0 1rem 0;
                text-shadow: 0 4px 8px rgba(0,0,0,0.3);
            }

            .shop-header p {
                color: var(--gray-light);
                font-size: 1.3rem;
                margin: 0;
                font-weight: 500;
            }

        /* Alerts */
        .alert {
            padding: 1rem 1.5rem;
            border-radius: 12px;
            margin-bottom: 1.5rem;
            backdrop-filter: blur(10px);
            border: 1px solid;
        }

        .alert-success {
            background: linear-gradient(135deg, rgba(25, 135, 84, 0.2), rgba(20, 108, 67, 0.1));
            border-color: rgba(25, 135, 84, 0.4);
            color: #d1e7dd;
        }

        .alert-danger {
            background: linear-gradient(135deg, rgba(220, 53, 69, 0.2), rgba(176, 42, 55, 0.1));
            border-color: rgba(220, 53, 69, 0.4);
            color: #f8d7da;
        }

        /* Add Product Button */
        .add-product-btn {
            display: inline-block;
            background: linear-gradient(135deg, var(--gold-primary), var(--gold-secondary));
            color: var(--gray-dark);
            padding: 1rem 2rem;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 700;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            box-shadow: 0 8px 25px rgba(222, 184, 65, 0.3);
            border: none;
        }

            .add-product-btn:hover {
                transform: translateY(-3px);
                box-shadow: 0 15px 35px rgba(222, 184, 65, 0.4);
                color: var(--gray-dark);
                text-decoration: none;
            }

        /* Products Grid */
        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 2rem;
            margin-bottom: 3rem;
        }

        /* Product Card */
        .product-card {
            background: linear-gradient(135deg, rgba(55, 50, 62, 0.95), rgba(109, 106, 117, 0.9));
            backdrop-filter: blur(20px);
            border: 1px solid rgba(222, 184, 65, 0.2);
            border-radius: 20px;
            overflow: hidden;
            transition: all 0.4s ease;
            box-shadow: 0 15px 35px rgba(55, 50, 62, 0.4);
            display: flex;
            flex-direction: column;
        }

            .product-card:hover {
                transform: translateY(-10px);
                box-shadow: 0 25px 50px rgba(55, 50, 62, 0.6);
                border-color: rgba(222, 184, 65, 0.5);
            }

        .product-image-container {
            position: relative;
            height: 250px;
            overflow: hidden;
        }

        .product-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

        .product-card:hover .product-image {
            transform: scale(1.1);
        }

        .image-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(55, 50, 62, 0.8), rgba(222, 184, 65, 0.3));
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .product-card:hover .image-overlay {
            opacity: 1;
        }

        .overlay-button {
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: white;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            transition: all 0.3s ease;
            cursor: pointer;
        }

            .overlay-button:hover {
                background: rgba(222, 184, 65, 0.3);
                border-color: var(--gold-primary);
                transform: scale(1.1);
            }

        /* Card Content */
        .card-content {
            padding: 1.5rem;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }

        .product-title {
            color: var(--gold-primary);
            font-size: 1.4rem;
            font-weight: 700;
            margin: 0 0 0.5rem 0;
        }

        .product-subtitle {
            color: var(--gray-medium);
            font-size: 0.9rem;
            margin: 0 0 1rem 0;
        }

        .product-description {
            color: var(--gray-light);
            line-height: 1.5;
            height: 4.5rem;
            overflow: hidden;
            margin-bottom: 1rem;
        }

        .price-tag {
            background: linear-gradient(135deg, var(--gold-primary), var(--gold-secondary));
            color: var(--gray-dark);
            padding: 0.75rem 1.25rem;
            border-radius: 25px;
            font-weight: 700;
            font-size: 1.2rem;
            display: inline-block;
            margin-bottom: 1.5rem;
            box-shadow: 0 4px 15px rgba(222, 184, 65, 0.3);
        }

        /* Buttons */
        .button-group {
            display: flex;
            gap: 0.75rem;
            margin-bottom: 1rem;
        }

        .btn {
            padding: 0.75rem 1rem;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
            flex: 1;
            text-align: center;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .btn-info {
            background: linear-gradient(135deg, rgba(13, 202, 240, 0.8), rgba(11, 156, 186, 0.7));
            color: white;
            border: 1px solid rgba(13, 202, 240, 0.3);
        }

            .btn-info:hover {
                background: linear-gradient(135deg, rgba(13, 202, 240, 1), rgba(11, 156, 186, 0.9));
                transform: translateY(-2px);
            }

        .btn-success {
            background: linear-gradient(135deg, rgba(25, 135, 84, 0.8), rgba(20, 108, 67, 0.7));
            color: white;
            border: 1px solid rgba(25, 135, 84, 0.3);
        }

            .btn-success:hover {
                background: linear-gradient(135deg, rgba(25, 135, 84, 1), rgba(20, 108, 67, 0.9));
                transform: translateY(-2px);
            }

        .btn-warning {
            background: linear-gradient(135deg, rgba(255, 193, 7, 0.8), rgba(255, 158, 0, 0.7));
            color: var(--gray-dark);
            border: 1px solid rgba(255, 193, 7, 0.3);
        }

            .btn-warning:hover {
                background: linear-gradient(135deg, rgba(255, 193, 7, 1), rgba(255, 158, 0, 0.9));
                transform: translateY(-2px);
            }

        .btn-danger {
            background: linear-gradient(135deg, rgba(220, 53, 69, 0.8), rgba(176, 42, 55, 0.7));
            color: white;
            border: 1px solid rgba(220, 53, 69, 0.3);
        }

            .btn-danger:hover {
                background: linear-gradient(135deg, rgba(220, 53, 69, 1), rgba(176, 42, 55, 0.9));
                transform: translateY(-2px);
            }

        /* Management Section */
        .management-section {
            padding-top: 1rem;
            border-top: 1px solid rgba(191, 189, 193, 0.2);
        }

        /* Modal */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.7);
        }

            .modal.show {
                display: flex;
                align-items: center;
                justify-content: center;
            }

        .modal-content {
            background: linear-gradient(135deg, rgba(55, 50, 62, 0.95), rgba(109, 106, 117, 0.9));
            backdrop-filter: blur(20px);
            border: 1px solid rgba(222, 184, 65, 0.3);
            border-radius: 20px;
            padding: 0;
            max-width: 500px;
            width: 90%;
            box-shadow: 0 25px 50px rgba(55, 50, 62, 0.6);
        }

        .modal-header {
            padding: 1.5rem;
            border-bottom: 1px solid rgba(222, 184, 65, 0.3);
        }

        .modal-title {
            color: var(--gold-primary);
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0;
        }

        .modal-close {
            position: absolute;
            right: 1rem;
            top: 1rem;
            background: none;
            border: none;
            color: var(--gray-light);
            font-size: 1.5rem;
            cursor: pointer;
        }

        .modal-body {
            padding: 1.5rem;
        }

            .modal-body img {
                width: 100%;
                max-height: 300px;
                object-fit: cover;
                border-radius: 10px;
                margin-bottom: 1rem;
            }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
        }

            .empty-state .card {
                background: linear-gradient(135deg, rgba(55, 50, 62, 0.95), rgba(109, 106, 117, 0.9));
                backdrop-filter: blur(20px);
                border: 1px solid rgba(222, 184, 65, 0.2);
                border-radius: 20px;
                padding: 3rem;
                box-shadow: 0 15px 35px rgba(55, 50, 62, 0.4);
            }

        .empty-icon {
            font-size: 5rem;
            color: var(--gold-primary);
            margin-bottom: 2rem;
        }

        .empty-title {
            color: var(--gold-primary);
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 1rem;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .shop-container

        {
            padding: 1rem;
        }

        .shop-header {
            padding: 2rem 1rem;
        }

            .shop-header h1 {
                font-size: 2.5rem;
            }

        .products-grid {
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
        }

        .button-group {
            flex-direction: column;
        }

        .btn {
            flex: none;
        }

        }

        @@media (max-width: 480px) {
            .products-grid

        {
            grid-template-columns: 1fr;
        }

        }

        /* Animation */
        @@keyframes fadeIn {
            from

        {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .fade-in {
            animation: fadeIn 0.6s ease-out;
        }
    </style>
</head>
<body>
    <div class="shop-container">
        <!-- Header -->
        <header class="shop-header fade-in">
            <h1><i class="fas fa-store"></i> Apex Volley Store</h1>
            <p>Scopri i nostri prodotti ufficiali della squadra</p>
        </header>

        <!-- Alerts -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success fade-in">
                <i class="fas fa-check-circle"></i>
                @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger fade-in">
                <i class="fas fa-exclamation-circle"></i>
                @TempData["ErrorMessage"]
            </div>
        }

        <!-- Add Product Button -->
        @if (canManage)
        {
            <div style="text-align: right; margin-bottom: 2rem;">
                <a href="@Url.Action("Create")" class="add-product-btn">
                    <i class="fas fa-plus-circle"></i> Aggiungi Prodotto
                </a>
            </div>
        }

        <!-- Products Grid -->
        <div class="products-grid">
            @foreach (var product in Model)
            {
                <article class="product-card fade-in">
                    <div class="product-image-container">
                        <img src="@product.ImageUrl" alt="@product.Name" class="product-image" />
                        <div class="image-overlay">
                            <button class="overlay-button" onclick="openModal('@product.Id')">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-content">
                        <h3 class="product-title">
                            <i class="fas fa-tag"></i> @product.Name
                        </h3>
                        <p class="product-subtitle">
                            <i class="fas fa-info-circle"></i> Descrizione
                        </p>
                        <div class="product-description">@product.Description</div>
                        <div class="price-tag">
                            <i class="fas fa-euro-sign"></i> @product.Price €
                        </div>

                        <div class="button-group">
                            <button class="btn btn-info" onclick="openModal('@product.Id')">
                                <i class="fas fa-info-circle"></i> Info
                            </button>
                            <form method="post" action="@Url.Action("Add", "Cart")" style="flex: 1;">
                                <input type="hidden" name="productId" value="@product.Id" />
                                <button type="submit" class="btn btn-success" style="width: 100%;">
                                    <i class="fas fa-shopping-cart"></i> Aggiungi
                                </button>
                            </form>
                        </div>

                        @if (canManage)
                        {
                            <div class="management-section">
                                <div class="button-group">
                                    <a href="@Url.Action("Edit", new { id = product.Id })" class="btn btn-warning">
                                        <i class="fas fa-edit"></i> Modifica
                                    </a>
                                    <form method="post" action="@Url.Action("Delete", new { id = product.Id })"
                                          onsubmit="return confirm('Sei sicuro di voler eliminare questo prodotto?');"
                                          style="flex: 1;">
                                        <button type="submit" class="btn btn-danger" style="width: 100%;">
                                            <i class="fas fa-trash-alt"></i> Elimina
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </article>

                <!-- Modal per ogni prodotto -->
                <div id="modal-@product.Id" class="modal">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 class="modal-title">
                                <i class="fas fa-tag"></i> @product.Name
                            </h2>
                            <button class="modal-close" onclick="closeModal('@product.Id')">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <div class="modal-body">
                            <img src="@product.ImageUrl" alt="@product.Name" />
                            <h4 style="color: var(--gold-primary); margin-bottom: 0.5rem;">
                                <i class="fas fa-align-left"></i> Descrizione:
                            </h4>
                            <p style="color: var(--gray-light); margin-bottom: 1rem;">@product.Description</p>
                            <div class="price-tag" style="margin-bottom: 1rem;">
                                <i class="fas fa-euro-sign"></i> @product.Price €
                            </div>
                            <form method="post" action="@Url.Action("Add", "Cart")">
                                <input type="hidden" name="productId" value="@product.Id" />
                                <button type="submit" class="btn btn-success" style="width: 100%;">
                                    <i class="fas fa-shopping-cart"></i> Aggiungi al Carrello
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Empty State -->
        @if (!Model.Any())
        {
            <div class="empty-state fade-in">
                <div class="card">
                    <i class="fas fa-shopping-bag empty-icon"></i>
                    <h2 class="empty-title">Nessun prodotto disponibile</h2>
                    <p style="color: var(--gray-light); margin-bottom: 2rem;">
                        Al momento non ci sono prodotti nel nostro store.
                    </p>
                    @if (canManage)
                    {
                        <a href="@Url.Action("Create")" class="add-product-btn">
                            <i class="fas fa-plus-circle"></i> Aggiungi il primo prodotto
                        </a>
                    }
                </div>
            </div>
        }
    </div>

    <script>
        // Modal Functions
        function openModal(productId) {
            document.getElementById('modal-' + productId).classList.add('show');
            document.body.style.overflow = 'hidden';
        }

        function closeModal(productId) {
            document.getElementById('modal-' + productId).classList.remove('show');
            document.body.style.overflow = 'auto';
        }

        // Close modal when clicking outside
        document.addEventListener('click', function(event) {
            if (event.target.classList.contains('modal')) {
                event.target.classList.remove('show');
                document.body.style.overflow = 'auto';
            }
        });

        // Staggered animation for cards
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.product-card');
            cards.forEach((card, index) => {
                card.style.animationDelay = (index * 0.1) + 's';
            });
        });

        // Responsive grid adjustment
        function adjustGrid() {
            const grid = document.querySelector('.products-grid');
            const width = window.innerWidth;

            if (width <= 480) {
                grid.style.gridTemplateColumns = '1fr';
            } else if (width <= 768) {
                grid.style.gridTemplateColumns = 'repeat(auto-fill, minmax(280px, 1fr))';
            } else {
                grid.style.gridTemplateColumns = 'repeat(auto-fill, minmax(300px, 1fr))';
            }
        }

        window.addEventListener('resize', adjustGrid);
        adjustGrid();
    </script>
</body>
</html>