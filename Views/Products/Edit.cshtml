@model ApexVolley.Models.Product
@{
    ViewData["Title"] = "Modifica Prodotto";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<div class="card shadow-sm">
    <div class="card-body">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }

        <form asp-action="Edit" enctype="multipart/form-data">
            @Html.AntiForgeryToken();
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label fw-semibold"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Immagine principale</label>
                <input type="file" name="MainImage" class="form-control" accept="image/*" />
                @if (Model?.ImageUrl != null)
                {
                    <img src="@Model.ImageUrl" class="img-fluid mt-2" style="max-height:150px;" />
                }
            </div>

            <button type="submit" class="btn btn-success">Salva Modifiche</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Annulla</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
