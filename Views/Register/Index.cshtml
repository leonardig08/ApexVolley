@model RegisterViewModel
@{
    ViewData["Title"] = "Registrazione";
}

<div class="registration-container">
    <div class="registration-card">
        <div class="registration-header">
            <div class="registration-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <line x1="19" y1="8" x2="19" y2="14"></line>
                    <line x1="22" y1="11" x2="16" y2="11"></line>
                </svg>
            </div>
            <h1 class="registration-title">Crea il tuo Account</h1>
            <p class="registration-subtitle">Compila i campi per registrarti</p>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.SelectMany(v => v.Errors).Any())
        {
        <div class="alert-premium alert-danger-premium">
            <div class="alert-icon">⚠️</div>
            <div class="alert-content">
                <strong>Attenzione!</strong>
                <ul class="mb-0 mt-2">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                    <li>@error.ErrorMessage</li>
                        }
                </ul>
            </div>
        </div>
        }

        <form method="post" asp-action="Index" class="registration-form">
            <div class="form-section">
                <h3 class="section-title">
                    <span class="section-number">1</span>
                    Credenziali di Accesso
                </h3>
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="form-group-premium">
                            <label asp-for="UserName" class="form-label-premium">
                                <span class="label-icon">👤</span>
                                Nome Utente
                            </label>
                            <input asp-for="UserName" class="form-control-premium" placeholder="Scegli un nome utente" />
                            <span asp-validation-for="UserName" class="validation-message"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group-premium">
                            <label asp-for="Email" class="form-label-premium">
                                <span class="label-icon">📧</span>
                                Email
                            </label>
                            <input asp-for="Email" class="form-control-premium" placeholder="tua@email.com" />
                            <span asp-validation-for="Email" class="validation-message"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group-premium">
                            <label asp-for="Password" class="form-label-premium">
                                <span class="label-icon">🔒</span>
                                Password
                            </label>
                            <input asp-for="Password" class="form-control-premium" placeholder="Inserisci password sicura" />
                            <span asp-validation-for="Password" class="validation-message"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group-premium">
                            <label asp-for="ConfirmPassword" class="form-label-premium">
                                <span class="label-icon">🔒</span>
                                Conferma Password
                            </label>
                            <input asp-for="ConfirmPassword" class="form-control-premium" placeholder="Ripeti la password" />
                            <span asp-validation-for="ConfirmPassword" class="validation-message"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="section-title">
                    <span class="section-number">2</span>
                    Informazioni Personali
                </h3>
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="form-group-premium">
                            <label asp-for="Nome" class="form-label-premium">
                                <span class="label-icon">✏️</span>
                                Nome
                            </label>
                            <input asp-for="Nome" class="form-control-premium" placeholder="Il tuo nome" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group-premium">
                            <label asp-for="Cognome" class="form-label-premium">
                                <span class="label-icon">✏️</span>
                                Cognome
                            </label>
                            <input asp-for="Cognome" class="form-control-premium" placeholder="Il tuo cognome" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-premium-submit">
                    <span class="btn-text">Crea Account</span>
                    <span class="btn-icon">→</span>
                </button>
            </div>
        </form>

        <div class="registration-footer">
            <p class="login-link">
                Hai già un account?
                <a asp-area="Identity" asp-page="/Account/Login" class="link-premium">
                    Accedi qui
                </a>
            </p>
        </div>
    </div>
</div>
