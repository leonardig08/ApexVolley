@model IEnumerable<ApexVolley.Models.Order>
@{
    ViewData["Title"] = "Gestione ordini";
}

<h2>Gestione ordini</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<table class="table table-hover align-middle mt-3">
    <thead>
        <tr>
            <th>Ordine</th>
            <th>Utente</th>
            <th>Nome</th>
            <th>Indirizzo</th>
            <th>Città</th>
            <th>CAP</th>
            <th>Paese</th>
            <th>Telefono</th>
            <th>Totale</th>
            <th>Stato</th>
            <th>Dettagli prodotti</th>
            <th>Azioni</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>#@order.Id</td>
                <td>@order.UserId</td>
                <td>@order.FullName</td>
                <td>@order.Address</td>
                <td>@order.City</td>
                <td>@order.ZipCode</td>
                <td>@order.Country</td>
                <td>@order.PhoneNumber</td>
                <td>@order.TotalAmount €</td>
                <td>@order.Status</td>
                <td>
                    <ul>
                        @foreach (var item in order.OrderItems)
                        {
                            <li>@item.Product.Name x @item.Quantity (@item.UnitPrice € ciascuno)</li>
                        }
                    </ul>
                </td>
                <td>
                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                        
                        <input type="hidden" name="orderId" value="@order.Id" />
                        <select name="newStatus" class="form-select form-select-sm d-inline w-auto">
                            <option value="Non pagato" selected="@((order.Status == "Non pagato") ? "selected" : null)">Non pagato</option>
                            <option value="Pagato" selected="@((order.Status == "Pagato") ? "selected" : null)">Pagato</option>
                            <option value="Pagato" selected="@((order.Status == "Pagato") ? "selected" : null)">Spedito</option>
                            <option value="In consegna" selected="@((order.Status == "In consegna") ? "selected" : null)">In consegna</option>
                            <option value="Consegnato" selected="@((order.Status == "Consegnato") ? "selected" : null)">Consegnato</option>
                        </select>
                        <button type="submit" class="btn btn-sm btn-success">Aggiorna</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
<footer class="border-top footer text-muted">
    <div class="container text-center">
        <p>
            &copy; 2025 - ApexVolley -
            <a href="/" class="text-apex-gold">Home</a> |
            <a href="mailto:info@apexvolley.it" class="text-apex-gold">Contatti</a> |
            <a asp-controller="Home" asp-action="Privacy" class="text-apex-gold">Privacy</a>
        </p>
    </div>
</footer>
