@model IEnumerable<ApexVolley.Models.Order>
@{
    ViewData["Title"] = "I tuoi ordini";
}

<h2>I tuoi ordini</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">Non hai ancora effettuato ordini.</div>
}
else
{
    <div class="list-group">
        @foreach (var order in Model)
        {
            <a asp-action="Details" asp-route-id="@order.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                <span>Ordine #@order.Id - @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                <span class="badge bg-primary rounded-pill">@order.TotalAmount €</span>
            </a>
        }
    </div>
}
