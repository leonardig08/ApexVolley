@model ApexVolley.Models.Order
@{
    ViewData["Title"] = "Dettaglio Ordine #" + Model.Id;
}

<h2>Ordine #@Model.Id</h2>
<p>Data: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
<p>Stato: <strong>@Model.Status</strong></p>

<table class="table table-hover align-middle mt-3">
    <thead>
        <tr>
            <th>Prodotto</th>
            <th>Prezzo</th>
            <th>Quantità</th>
            <th>Totale</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderItems)
        {
            <tr>
                <td>@item.Product.Name</td>
                <td>@item.UnitPrice €</td>
                <td>@item.Quantity</td>
                <td>@(item.UnitPrice* item.Quantity) €</td>
            </tr>
        }
    </tbody>
</table>

<h4 class="mt-3">Totale ordine: @Model.TotalAmount €</h4>
<a asp-action="Index" class="btn btn-secondary mt-3">Torna ai tuoi ordini</a>
<footer class="border-top footer text-muted">
    <div class="container text-center">
        <p>
            &copy; 2025 - ApexVolley -
            <a href="/" class="text-apex-gold">Home</a> |
            <a href="mailto:info@apexvolley.it" class="text-apex-gold">Contatti</a> |
            <a asp-controller="Home" asp-action="Privacy" class="text-apex-gold">Privacy</a>
        </p>
    </div>
</footer>