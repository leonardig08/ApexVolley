@model ApexVolley.Models.Order
@{
    ViewData["Title"] = "Dettaglio Ordine #" + Model.Id;
}

<style>
    .order-detail-wrapper {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: 100vh;
        padding: 3rem 0;
    }

    .order-detail-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    /* Back Button */
    .back-navigation {
        margin-bottom: 2rem;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: white;
        color: #666;
        text-decoration: none;
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

        .btn-back:hover {
            background: #f8f9fa;
            color: #1a1a1a;
            transform: translateX(-4px);
            text-decoration: none;
        }

    /* Order Header */
    .order-header-card {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    }

    .order-header-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 2px solid #f0f0f0;
    }

    .order-title {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .order-icon {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #d4af37 0%, #f4d03f 100%);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
    }

    .order-title-text h1 {
        font-size: 2rem;
        font-weight: 800;
        color: #1a1a1a;
        margin: 0;
    }

    .order-title-text p {
        color: #666;
        margin: 0.25rem 0 0 0;
        font-size: 1rem;
    }

    .order-status-badge {
        padding: 0.75rem 1.5rem;
        border-radius: 25px;
        font-size: 1rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .status-non-pagato {
        background: linear-gradient(135deg, #ffeaa7 0%, #fdcb6e 100%);
        color: #7d5b00;
    }

    .status-pagato {
        background: linear-gradient(135deg, #81ecec 0%, #00cec9 100%);
        color: #004d4d;
    }

    .status-spedito {
        background: linear-gradient(135deg, #a29bfe 0%, #6c5ce7 100%);
        color: #2d1f5e;
    }

    .status-in-consegna {
        background: linear-gradient(135deg, #74b9ff 0%, #0984e3 100%);
        color: #003d6b;
    }

    .status-consegnato {
        background: linear-gradient(135deg, #55efc4 0%, #00b894 100%);
        color: #004d3f;
    }

    .order-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
    }

    .info-box {
        background: #f8f9fa;
        padding: 1.25rem;
        border-radius: 10px;
        border-left: 4px solid #d4af37;
    }

    .info-label {
        font-size: 0.8rem;
        text-transform: uppercase;
        color: #666;
        font-weight: 600;
        letter-spacing: 0.5px;
        margin-bottom: 0.5rem;
    }

    .info-value {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1a1a1a;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    /* Shipping Info */
    .shipping-info-card {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    }

    .section-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .shipping-details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
    }

    .shipping-box {
        background: #f8f9fa;
        padding: 1.5rem;
        border-radius: 12px;
    }

        .shipping-box h4 {
            font-size: 0.9rem;
            text-transform: uppercase;
            color: #666;
            font-weight: 600;
            letter-spacing: 0.5px;
            margin-bottom: 1rem;
        }

        .shipping-box p {
            margin: 0.5rem 0;
            color: #1a1a1a;
            font-size: 1rem;
        }

        .shipping-box strong {
            font-weight: 600;
        }

    /* Products Section */
    .products-card {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    }

    .products-list {
        margin-top: 1.5rem;
    }

    .product-item {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-left: 4px solid #d4af37;
        transition: all 0.3s ease;
    }

        .product-item:hover {
            background: #fff8e1;
            transform: translateX(4px);
        }

        .product-item:last-child {
            margin-bottom: 0;
        }

    .product-info {
        flex: 1;
    }

    .product-name {
        font-size: 1.2rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 0.5rem;
    }

    .product-details {
        display: flex;
        gap: 2rem;
        color: #666;
        font-size: 0.95rem;
    }

    .product-detail-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .product-total {
        font-size: 1.5rem;
        font-weight: 700;
        color: #d4af37;
        text-align: right;
    }

    /* Order Summary */
    .order-summary-card {
        background: linear-gradient(135deg, #fff8dc 0%, #fffacd 100%);
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 4px 16px rgba(212, 175, 55, 0.2);
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 0;
        border-bottom: 2px solid rgba(212, 175, 55, 0.2);
    }

        .summary-row:last-child {
            border-bottom: none;
            padding-top: 1.5rem;
        }

    .summary-label {
        font-size: 1rem;
        color: #666;
    }

    .summary-value {
        font-size: 1.1rem;
        font-weight: 600;
        color: #1a1a1a;
    }

    .summary-total {
        font-size: 2rem !important;
        font-weight: 800 !important;
        color: #d4af37 !important;
    }

    /* Action Buttons */
    .action-buttons {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
    }

    .btn-action {
        flex: 1;
        padding: 1rem 2rem;
        border: none;
        border-radius: 12px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-align: center;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .btn-primary-action {
        background: linear-gradient(135deg, #d4af37 0%, #f4d03f 100%);
        color: #1a1a1a;
        box-shadow: 0 4px 12px rgba(212, 175, 55, 0.3);
    }

        .btn-primary-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(212, 175, 55, 0.4);
            text-decoration: none;
            color: #1a1a1a;
        }

    .btn-secondary-action {
        background: white;
        color: #666;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

        .btn-secondary-action:hover {
            background: #f8f9fa;
            color: #1a1a1a;
            text-decoration: none;
        }

    /* Responsive */
    @@media (max-width: 768px) {
        .order-detail-container

    {
        padding: 0 1rem;
    }

    .order-header-top {
        flex-direction: column;
        gap: 1rem;
        text-align: center;
    }

    .order-title {
        flex-direction: column;
    }

    .order-title-text h1 {
        font-size: 1.5rem;
    }

    .product-item {
        flex-direction: column;
        gap: 1rem;
        text-align: center;
    }

    .product-details {
        flex-direction: column;
        gap: 0.5rem;
    }

    .action-buttons {
        flex-direction: column;
    }

    }
</style>

<div class="order-detail-wrapper">
    <div class="order-detail-container">
        <div class="back-navigation">
            <a asp-action="Index" class="btn-back">
                <span>←</span>
                <span>Torna ai tuoi ordini</span>
            </a>
        </div>

        <div class="order-header-card">
            <div class="order-header-top">
                <div class="order-title">
                    <div class="order-icon">📦</div>
                    <div class="order-title-text">
                        <h1>Ordine #@Model.Id</h1>
                        <p>Effettuato il @Model.CreatedAt.ToString("dd/MM/yyyy") alle @Model.CreatedAt.ToString("HH:mm")</p>
                    </div>
                </div>
                <div class="order-status-badge @($"status-{Model.Status.ToLower().Replace(" ", "-")}")">
                    @Model.Status
                </div>
            </div>

            <div class="order-info-grid">
                <div class="info-box">
                    <div class="info-label">Data Ordine</div>
                    <div class="info-value">
                        <span>📅</span>
                        <span>@Model.CreatedAt.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>
                <div class="info-box">
                    <div class="info-label">Ora</div>
                    <div class="info-value">
                        <span>🕐</span>
                        <span>@Model.CreatedAt.ToString("HH:mm")</span>
                    </div>
                </div>
                <div class="info-box">
                    <div class="info-label">Prodotti</div>
                    <div class="info-value">
                        <span>📦</span>
                        <span>@Model.OrderItems.Count() @(Model.OrderItems.Count() == 1 ? "prodotto" : "prodotti")</span>
                    </div>
                </div>
                <div class="info-box">
                    <div class="info-label">Stato</div>
                    <div class="info-value">
                        <span>🔄</span>
                        <span>@Model.Status</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="shipping-info-card">
            <h2 class="section-title">
                <span>📍</span>
                <span>Informazioni di Spedizione</span>
            </h2>
            <div class="shipping-details">
                <div class="shipping-box">
                    <h4>👤 Destinatario</h4>
                    <p><strong>@Model.FullName</strong></p>
                </div>
                <div class="shipping-box">
                    <h4>📮 Indirizzo</h4>
                    <p>@Model.Address</p>
                    <p>@Model.City, @Model.ZipCode</p>
                    <p>@Model.Country</p>
                </div>
                <div class="shipping-box">
                    <h4>📞 Contatto</h4>
                    <p><strong>@Model.PhoneNumber</strong></p>
                </div>
            </div>
        </div>

        <div class="products-card">
            <h2 class="section-title">
                <span>🛍️</span>
                <span>Prodotti Ordinati</span>
            </h2>
            <div class="products-list">
                @foreach (var item in Model.OrderItems)
                {
                    <div class="product-item">
                        <div class="product-info">
                            <div class="product-name">@item.Product.Name</div>
                            <div class="product-details">
                                <div class="product-detail-item">
                                    <span>💰</span>
                                    <span>@item.UnitPrice.ToString("F2")€ cad.</span>
                                </div>
                                <div class="product-detail-item">
                                    <span>✕</span>
                                    <span>@item.Quantity</span>
                                </div>
                            </div>
                        </div>
                        <div class="product-total">
                            @((item.UnitPrice * item.Quantity).ToString("F2"))€
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="order-summary-card">
            <div class="summary-row">
                <span class="summary-label">Subtotale prodotti:</span>
                <span class="summary-value">@Model.OrderItems.Sum(i => i.UnitPrice * i.Quantity).ToString("F2")€</span>
            </div>
            <div class="summary-row">
                <span class="summary-label">Spedizione:</span>
                <span class="summary-value">Inclusa</span>
            </div>
            <div class="summary-row">
                <span class="summary-label"><strong>Totale Ordine:</strong></span>
                <span class="summary-value summary-total">@Model.TotalAmount.ToString("F2")€</span>
            </div>
        </div>

        <div class="action-buttons">
            <a asp-action="Index" class="btn-action btn-secondary-action">
                <span>←</span>
                <span>Torna ai tuoi ordini</span>
            </a>
            <a href="/" class="btn-action btn-primary-action">
                <span>🛍️</span>
                <span>Continua lo Shopping</span>
            </a>
        </div>
    </div>
</div>

<footer class="border-top footer text-muted">
    <div class="container text-center">
        <p>
            &copy; 2025 - ApexVolley -
            <a href="/" class="text-apex-gold">Home</a> |
            <a href="mailto:info@apexvolley.it" class="text-apex-gold">Contatti</a> |
            <a asp-controller="Home" asp-action="Privacy" class="text-apex-gold">Privacy</a>
        </p>
    </div>
</footer>